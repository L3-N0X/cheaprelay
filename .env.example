# Copy to .env and fill in. See README.md for all options.

# --- Required -------------------------------------------------------------
# Twitch dashboard -> Settings -> Stream -> Primary Stream Key
TWITCH_STREAM_KEY=live_000000000_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Strongly recommended -------------------------------------------------
# Protects the control API / web UI. Generate with: openssl rand -hex 24
API_TOKEN=
# SRT encryption, 10-79 characters. Set the same passphrase in the phone app.
SRT_PASSPHRASE=

# --- Optional ---------------------------------------------------------------
# Closest Twitch ingest server, see https://help.twitch.tv/s/twitch-ingest-recommendation
#TWITCH_RTMP_URL=rtmp://live.twitch.tv/app
# Only accept SRT connections with exactly this stream id
#SRT_STREAM_ID=
#SRT_LATENCY=2s
#INPUT_TIMEOUT=1500ms
#LIVE_STABLE_TIME=3s
#FALLBACK_MAX_DURATION=0
#FALLBACK_FILE=/media/fallback.mp4
#AUTOSTART=false
#FFMPEG_ANALYZE_DURATION=1s
#FFMPEG_LOGLEVEL=warning
#LOG_LEVEL=info
